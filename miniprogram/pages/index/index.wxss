.page {
  min-height: 100vh;
  padding: 30rpx 28rpx 60rpx;
  background: #f6f5fb;
  box-sizing: border-box;
}

.hero {
  padding: 26rpx 30rpx 30rpx;
  background: linear-gradient(135deg, rgba(123, 118, 237, 0.1), rgba(93, 88, 219, 0.06));
  border: 1rpx solid rgba(220, 218, 239, 0.8);
  border-radius: 28rpx;
}

.hero-eyebrow {
  font-size: 20rpx;
  letter-spacing: 0.32em;
  color: #7f82dc;
  font-weight: 700;
}

.hero-title {
  margin-top: 14rpx;
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: #242433;
}

.hero-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: #6f6d80;
}

.chips {
  display: flex;
  margin: 30rpx 0 26rpx;
}

.chip + .chip {
  margin-left: 14rpx;
}

.chip {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 18rpx 0 16rpx;
  background: #ffffff;
  border: 1rpx solid rgba(232, 231, 240, 0.95);
  border-radius: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(46, 43, 79, 0.05);
  transition: all 180ms ease;
}

.chip.is-active {
  background: linear-gradient(135deg, #7b76ed, #5d58db);
  border-color: transparent;
  box-shadow: 0 10rpx 24rpx rgba(90, 84, 216, 0.28);
}

.chip-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #55536b;
}

.chip.is-active .chip-name {
  color: #ffffff;
}

.chip-count {
  font-size: 19rpx;
  font-weight: 700;
  color: #9a97b5;
  font-variant-numeric: tabular-nums;
}

.chip.is-active .chip-count {
  color: rgba(255, 255, 255, 0.72);
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.card {
  /* 固定 rpx 宽度（calc 混合 % 与 rpx 在真机上失效） */
  width: 337rpx;
  box-sizing: border-box;
  padding: 24rpx 22rpx 20rpx;
  margin-bottom: 20rpx;
  background: #ffffff;
  border: 1rpx solid rgba(232, 231, 240, 0.95);
  border-radius: 22rpx;
  box-shadow: 0 8rpx 22rpx rgba(46, 43, 79, 0.05);
  display: flex;
  flex-direction: column;
  min-height: 210rpx;
}

.card:active {
  transform: scale(0.98);
}

.card-index {
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: #a5a2c0;
}

.card-name {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #242433;
}

.card-tagline {
  flex: 1;
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: #7c7a8f;
}

.card-cta {
  margin-top: 14rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #5d58db;
}

.site-footer {
  margin-top: 44rpx;
  text-align: center;
  font-size: 22rpx;
  letter-spacing: 0.05em;
  color: #9a97b5;
}
